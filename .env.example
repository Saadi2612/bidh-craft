# ---------------------------------------------------------------------------
# Storefront environment. Copy to `.env` (and set the same values in Lovable /
# Cloudflare for production). The CMS has its own file at cms/.env.example.
# ---------------------------------------------------------------------------

# Where the Payload CMS is served from. Leave blank to render the bundled
# fallback content instead of live CMS data.
# Local: http://localhost:3000 · Production: https://your-cms.vercel.app
VITE_CMS_URL=

# Cloudinary cloud name, so the site can request images at the size it renders
# (f_auto,q_auto). Not a secret — it appears in every image URL.
VITE_CLOUDINARY_CLOUD_NAME=

# Shared secret that lets the CMS clear this site's content cache immediately
# after an edit. Must match REVALIDATE_SECRET in cms/.env. Never prefix this
# with VITE_ — that would ship it to the browser.
SITE_REVALIDATE_SECRET=
