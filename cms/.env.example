# ---------------------------------------------------------------------------
# Copy to `cms/.env` and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

# Long random string. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Remember to add a database name before the query string, e.g. .../bidhcraft?retryWrites=true
DATABASE_URI=

# Public URL this CMS is served from. http://localhost:3000 in dev,
# https://your-cms.vercel.app in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary — Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# All uploads land under this Cloudinary folder.
CLOUDINARY_FOLDER=bidhcraft

# Comma-separated origins allowed to call the REST API from a browser.
# Include the live site and any preview domains.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Shared secret the site sends to purge its content cache, and that this CMS
# sends back when content changes. Must match SITE_REVALIDATE_SECRET on the site.
REVALIDATE_SECRET=

# Where to ping when content changes so the live site drops its cached snapshot.
# Leave blank to disable. Example: https://thebidhcraft.com
SITE_URL=
